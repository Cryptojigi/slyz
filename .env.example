# Slyz Production Environment Variables
# Configure these in .env.local and Vercel Project Settings before production deployment

# Primary Dedicated Solana RPC (e.g. Alchemy Solana Mainnet URL)
# NOTE: Slyz uses a SINGLE RPC — there is no fallback provider, by design.
# The Alchemy app MUST allowlist the deployed origin (e.g. https://www.useslyz.xyz or https://useslyz.vercel.app),
# otherwise both balance reads and transaction sends fail.
NEXT_PUBLIC_ALCHEMY_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Public App URL (used for Vercel social preview cards, gift claims & metadataBase)
NEXT_PUBLIC_APP_URL=https://www.useslyz.xyz

# Solana Network
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# Jupiter Swap Unified Lite API
NEXT_PUBLIC_JUPITER_API_URL=https://lite-api.jup.ag

# WalletConnect / Reown Cloud project id — https://cloud.reown.com
# REQUIRED for MOBILE wallet connections (QR / deep link from a phone browser).
# The deployed domain MUST be on this project's allowlist, or the relay rejects
# the connection with "origin not allowed".
NEXT_PUBLIC_WC_PROJECT_ID=

# PreStocks upstream API (SERVER-ONLY override).
#
# The client always fetches the same-origin proxy `/api/prestocks`
# (src/app/api/prestocks/route.ts), because https://prestocks.com/api/prestocks
# returns valid JSON but sends NO CORS headers — browsers block it outright.
#
# This variable configures the UPSTREAM that the proxy fetches. Do NOT rename it
# to NEXT_PUBLIC_*: that would leak into the client bundle and let the app point
# straight back at the CORS-blocked endpoint.
# PreStocks requires no API key or auth token. Defaults to the URL below.
PRESTOCKS_API_URL=https://prestocks.com/api/prestocks

# Supabase Project Configuration (slyz project)
NEXT_PUBLIC_SUPABASE_URL=https://rwddfbilnuwsfxuezkbi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Gift Vault AES-256-GCM Symmetric Encryption Key (32-byte hex string)
# CRITICAL: MUST match between development and production Vercel environment variables!
GIFT_SECRET_KEY=YOUR_32_BYTE_HEX_GIFT_SECRET_KEY

# Telegram Feedback & Inquiry System (Optional)
# When configured, submissions to /api/feedback dispatch alerts directly to your Telegram chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NEXT_PUBLIC_TELEGRAM_SUPPORT_URL=https://t.me/Useslyz
NEXT_PUBLIC_SUPPORT_EMAIL=support@useslyz.xyz


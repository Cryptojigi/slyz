# Slyz Production Environment Variables
# Configure these in .env.local and Vercel Project Settings before production deployment

# Dedicated Solana RPC (e.g. Alchemy Solana Mainnet URL)
NEXT_PUBLIC_ALCHEMY_RPC_URL=https://api.mainnet-beta.solana.com

# Solana Network
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# Jupiter Swap Unified Lite API (Do NOT use api.jup.ag/quote/v6)
NEXT_PUBLIC_JUPITER_API_URL=https://lite-api.jup.ag

# xStocks Public Metadata & Multipliers API
NEXT_PUBLIC_XSTOCKS_API_URL=https://api.xstocks.fi
